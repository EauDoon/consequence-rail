{
  "openapi": "3.1.0",
  "info": {
    "title": "Consequence Rail Reference API",
    "version": "0.2.0",
    "description": "Experimental loopback-only reference API for recourse-gated execution and optional recovery preflight. The server keeps runtime state in memory, accepts JSON bodies up to 65,536 bytes, enforces same-origin loopback Host and Origin values, rejects unknown or repeated query parameters before route mutation, and may return 400, 403, 405, 413, 415, 429, 500, or 503 boundary errors before route-specific processing. Failure bodies include a request_id for correlation; unexpected exceptions are logged to stderr and returned as INTERNAL_ERROR without leaking the cause."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/.well-known/consequence-rail": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "Describe protocol and connector capabilities",
        "responses": {
          "200": {
            "description": "Capability document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "protocol_version",
                    "implementation",
                    "assurance_modes",
                    "executable_modes",
                    "optional_features",
                    "connector"
                  ],
                  "properties": {
                    "protocol_version": { "const": "v0.1" },
                    "implementation": { "type": "string" },
                    "assurance_modes": { "type": "array", "items": { "type": "string" } },
                    "executable_modes": { "type": "array", "items": { "type": "string" } },
                    "optional_features": { "type": "array", "items": { "type": "string" } },
                    "connector": { "$ref": "#/components/schemas/ConnectorCapabilities" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v0/actions": {
      "post": {
        "operationId": "proposeAction",
        "summary": "Register an immutable ActionProposal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "../spec/schemas/action-proposal.schema.json" },
                  { "$ref": "../spec/schemas/action-proposal-v0.2.schema.json" }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/ActionView"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        }
      ],
      "get": {
        "operationId": "inspectAction",
        "summary": "Read redacted action state and event-chain metadata",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ActionView"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}/authorize": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        }
      ],
      "post": {
        "operationId": "authorizeAction",
        "summary": "Bind an external policy decision to the action",
        "description": "The loopback v0.1 reference accepts this decision without authenticating a policy service. Real connectors require an authenticated policy adapter.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizationDecision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ActionView"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}/recourse": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        }
      ],
      "post": {
        "operationId": "reserveRecourse",
        "summary": "Ask the connector to reserve and sign a bounded remedy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecourseReservationInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ActionView"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}/recovery-preflight": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        }
      ],
      "post": {
        "operationId": "acceptRecoveryPreflight",
        "summary": "Verify and accept a signed recovery drill bundle",
        "description": "The rail verifies evidence produced outside the live action path. This endpoint never executes a drill plan.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../spec/schemas/recovery-drill-bundle.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ActionView"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}/permit": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        }
      ],
      "post": {
        "operationId": "issuePermit",
        "summary": "Issue a signed single-use execution permit",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ActionView"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}/execute": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        }
      ],
      "post": {
        "operationId": "executeAction",
        "summary": "Consume the permit and call the protected connector",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecutionFaultInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ActionView"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}/reconcile": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        }
      ],
      "post": {
        "operationId": "reconcileAction",
        "summary": "Resolve UNKNOWN through connector status without re-execution",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ActionView"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}/verify-outcome": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        }
      ],
      "post": {
        "operationId": "verifyOutcome",
        "summary": "Evaluate the configured postcondition against declared evidence",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceFaultInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ActionView"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}/remediate": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        }
      ],
      "post": {
        "operationId": "remediateAction",
        "summary": "Execute and verify the pre-reserved bounded remedy",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemediationFaultInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ActionView"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}/reconcile-remedy": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        }
      ],
      "post": {
        "operationId": "reconcileRemedy",
        "summary": "Resolve REMEDY_UNKNOWN through connector status without retry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "evidenceFault": {
                    "enum": [
                      "none",
                      "post-remedy-stale-evidence",
                      "post-remedy-false-evidence"
                    ],
                    "description": "Synthetic post-remedy evidence fault for the mock connector."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ActionView"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/actions/{action_id}/bundle": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ActionId"
        },
        {
          "name": "profile",
          "in": "query",
          "required": false,
          "schema": {
            "enum": [
              "receipt",
              "audit"
            ],
            "default": "receipt"
          },
          "description": "Receipt omits raw proposal and evidence. Audit includes them for semantic verification."
        }
      ],
      "get": {
        "operationId": "exportSettlementBundle",
        "summary": "Export a privacy-minimized receipt or full audit bundle",
        "responses": {
          "200": {
            "description": "Settlement bundle",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "../spec/schemas/settlement-bundle.schema.json" },
                    { "$ref": "../spec/schemas/settlement-bundle-v0.2.schema.json" }
                  ]
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v0/bundles/verify": {
      "post": {
        "operationId": "verifySettlementBundle",
        "summary": "Verify integrity and semantics of an audit bundle against configured trusted keys",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "../spec/schemas/settlement-bundle.schema.json" },
                  { "$ref": "../spec/schemas/settlement-bundle-v0.2.schema.json" }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "valid",
                    "integrity",
                    "semantics",
                    "action_id",
                    "outcome",
                    "assurance_mode",
                    "bypass_possible",
                    "event_count",
                    "event_chain_head",
                    "trusted_key_id",
                    "trusted_connector_key_id"
                  ],
                  "properties": {
                    "valid": {
                      "const": true
                    },
                    "integrity": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["valid", "event_count", "event_chain_head"],
                      "properties": {
                        "valid": { "const": true },
                        "event_count": { "type": "integer", "minimum": 0 },
                        "event_chain_head": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{43}$"
                        }
                      }
                    },
                    "semantics": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["status", "valid"],
                      "properties": {
                        "status": { "const": "verified" },
                        "valid": { "const": true },
                        "final_state": { "const": "CLOSED" },
                        "derived_outcome": {
                          "enum": ["settled", "compensated", "disputed"]
                        },
                        "evidence_count": { "type": "integer", "minimum": 0 }
                      }
                    },
                    "action_id": {
                      "type": "string"
                    },
                    "outcome": {
                      "enum": [
                        "settled",
                        "compensated",
                        "disputed"
                      ]
                    },
                    "assurance_mode": {
                      "enum": ["enforced", "cooperative"]
                    },
                    "bypass_possible": {
                      "type": "boolean"
                    },
                    "event_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "event_chain_head": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{43}$"
                    },
                    "trusted_key_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "trusted_connector_key_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ActionId": {
        "name": "action_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]{20}$"
        }
      }
    },
    "responses": {
      "ActionView": {
        "description": "Redacted action state",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ActionView"
            }
          }
        }
      },
      "Error": {
        "description": "Stable machine-readable error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ActionView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "action_digest",
          "action_type",
          "resource",
          "state",
          "assurance_mode",
          "bypass_possible",
          "permit_uses",
          "remedy_attempts",
          "event_count",
          "event_chain_head",
          "outcome"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "action_digest": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "action_type": {
            "type": "string"
          },
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id_digest"],
            "properties": {
              "type": { "type": "string" },
              "id_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
            }
          },
          "state": {
            "type": "string"
          },
          "assurance_mode": {
            "enum": [
              "enforced",
              "cooperative",
              "observed"
            ]
          },
          "bypass_possible": {
            "type": "boolean"
          },
          "event_count": {
            "type": "integer"
          },
          "permit_uses": {
            "type": "integer",
            "minimum": 0
          },
          "remedy_attempts": {
            "type": "integer",
            "minimum": 0
          },
          "event_chain_head": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "recovery_preflight_required": {
            "type": "boolean"
          },
          "recovery_preflight_qualification": {
            "type": [
              "string",
              "null"
            ]
          },
          "recovery_preflight_attestation_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "AuthorizationDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allow",
          "policy_id",
          "policy_digest"
        ],
        "properties": {
          "allow": {
            "type": "boolean"
          },
          "policy_id": {
            "type": "string"
          },
          "policy_digest": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "evaluation_input_digest": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "require_recovery_preflight": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "RecourseReservationInput": {
        "type": "object",
        "additionalProperties": false,
        "description": "Requested remedy scope. The connector returns a separately signed commitment that the rail binds into the accepted reservation.",
        "required": [
          "action_digest",
          "kind",
          "connector",
          "capability",
          "capability_reference",
          "expires_at",
          "remedy_window_seconds",
          "max_attempts",
          "max_amount_minor",
          "idempotency_key"
        ],
        "properties": {
          "action_digest": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "kind": {
            "enum": [
              "reverse",
              "compensate",
              "escalate"
            ]
          },
          "connector": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "capability_reference": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "remedy_window_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "max_amount_minor": {
            "type": "integer",
            "minimum": 0
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ExecutionFaultInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fault": {
            "enum": [
              "none",
              "duplicate",
              "lost-response-before-commit",
              "lost-response-after-commit",
              "remedy-failure"
            ],
            "description": "Synthetic action, evidence, or remedy fault accepted only by the demo connector."
          }
        }
      },
      "EvidenceFaultInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fault": {
            "enum": ["none", "stale-evidence"]
          }
        }
      },
      "RemediationFaultInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fault": {
            "enum": [
              "none",
              "remedy-failure",
              "remedy-lost-response-before-commit",
              "remedy-lost-response-after-commit",
              "post-remedy-stale-evidence",
              "post-remedy-false-evidence"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "pattern": "^req_[A-Za-z0-9_-]{22}$"
          },
          "action_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "ConnectorCapabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connector",
          "exclusive_credential_custody",
          "actions",
          "remedies",
          "connector_signing_key_id"
        ],
        "properties": {
          "connector": { "type": "string", "minLength": 1 },
          "exclusive_credential_custody": { "type": "boolean" },
          "actions": { "type": "array", "items": { "type": "string" } },
          "remedies": { "type": "array", "items": { "type": "string" } },
          "connector_signing_key_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
