{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:consequence-rail:schema:recovery-contract:v0.1",
  "title": "RecoveryContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "action_digest",
    "action_class",
    "scope",
    "recourse",
    "recovery_class",
    "fixture",
    "fault",
    "procedure",
    "oracle",
    "issued_at",
    "expires_at",
    "max_attestation_age_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "consequence-rail/recovery-contract/v0.1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "action_digest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "action_class": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector",
        "resource_type",
        "assurance_mode",
        "parameters_digest",
        "postcondition_digest",
        "evidence_plan_digest"
      ],
      "properties": {
        "connector": { "type": "string", "minLength": 1 },
        "resource_type": { "type": "string", "minLength": 1 },
        "assurance_mode": { "enum": ["enforced", "cooperative"] },
        "parameters_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "postcondition_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "evidence_plan_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    },
    "recourse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capability",
        "implementation_digest",
        "reservation_digest",
        "capability_reference_digest",
        "connector_commitment_digest"
      ],
      "properties": {
        "kind": { "enum": ["reverse", "compensate", "escalate"] },
        "capability": { "type": "string", "minLength": 1 },
        "implementation_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "reservation_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "capability_reference_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "connector_commitment_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    },
    "recovery_class": {
      "enum": ["exact", "compensation", "containment", "escalation"]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "adapter_version",
        "adapter_implementation_digest",
        "checkpoint_digest",
        "fidelity",
        "configuration"
      ],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "adapter_implementation_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "checkpoint_digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "fidelity": { "enum": ["synthetic", "staging", "production-like"] },
        "configuration": { "type": "object", "additionalProperties": true }
      }
    },
    "fault": { "$ref": "#/$defs/operation" },
    "procedure": { "$ref": "#/$defs/operation" },
    "oracle": { "$ref": "#/$defs/operation" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "max_attestation_age_seconds": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "parameters"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
