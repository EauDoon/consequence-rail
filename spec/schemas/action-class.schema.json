{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:consequence-rail:schema:action-class:v0.1",
  "title": "ActionClass",
  "description": "A rail operator registers one ActionClass per action type it admits through ActionProposal v0.3. The class closes the parameters, fixes the remedy scope and lists evidence facts that must equal parameters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_type",
    "parameters",
    "recourse",
    "evidence_bindings"
  ],
  "properties": {
    "action_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+/v[1-9][0-9]*$",
      "not": {
        "enum": [
          "demo.refund.issue/v1",
          "demo.email.send/v1",
          "demo.inventory.allocate/v1"
        ]
      }
    },
    "description": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "recourse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_field",
        "covers_parameter",
        "kinds"
      ],
      "properties": {
        "scope_field": {
          "enum": [
            "max_amount_minor",
            "max_quantity"
          ]
        },
        "covers_parameter": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "reverse",
              "compensate",
              "escalate"
            ]
          }
        }
      }
    },
    "evidence_bindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact",
          "parameter"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "parameter": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        }
      }
    }
  },
  "$defs": {
    "parameter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "min_length": {
              "type": "integer",
              "minimum": 0
            },
            "max_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "minimum": {
              "type": "integer"
            },
            "maximum": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            }
          }
        }
      ]
    }
  }
}
